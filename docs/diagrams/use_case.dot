digraph G { graph [rankdir=LR,bgcolor="white",pad=0.3]; node [shape=box,style="rounded,filled",fillcolor="#e9f6f0",color="#24664e",fontname="Arial"]; student [shape=ellipse,label="Student"]; advisor [shape=ellipse,label="Assigned advisor"]; dash [label="View progress / transfer credits"]; plan [label="Build temporary What If? plan"]; status [label="Check prerequisites & timeline"]; notes [label="Read recommendations"]; add [label="Write advisor recommendation"]; student -> dash;student -> plan;student -> status;student -> notes;advisor -> dash;advisor -> notes;advisor -> add; }
